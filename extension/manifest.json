{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.6",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "sidePanel",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.moonshot.cn/*"
  ],
  "optional_permissions": ["bookmarks"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"},
    "default_title": "__MSG_actionTitle__"
  },
  "options_page": "dashboard.html#settings",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.deepseek.com https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://dashscope.aliyuncs.com https://api.moonshot.cn"
  },
  "side_panel": {
    "default_path": "dashboard.html?surface=sidepanel"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "default_locale": "zh_CN"
}
